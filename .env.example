APP_NAME=DebugLens
APP_ENV=local
LOG_LEVEL=INFO
# Safe default. Choose one provider explicitly: mock, openai_compatible, anthropic, gemini.
ANALYSIS_PROVIDER=mock
MAX_UPLOAD_BYTES=10485760
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
VISION_TIMEOUT_SECONDS=45
DATABASE_PATH=./data/debuglens.db
# Optional in local development. Required when APP_ENV=production.
# API_ACCESS_TOKEN=replace-with-a-long-random-secret

# Browser capture is disabled by default. Only enable inside a disposable environment with
# network egress controls and exact allow-listed test hosts.
BROWSER_ENABLED=false
BROWSER_ALLOWED_HOSTS=

# OpenAI or an OpenAI Chat Completions-compatible endpoint
# VISION_API_KEY=
# VISION_MODEL=gpt-4.1-mini
# VISION_BASE_URL=https://api.openai.com/v1

# Anthropic native Messages API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini native API
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
