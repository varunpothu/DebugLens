APP_NAME=DebugLens
APP_ENV=local
LOG_LEVEL=INFO
# mock is the safe default. Set openai_compatible only after reviewing provider privacy and cost.
ANALYSIS_PROVIDER=mock
MAX_UPLOAD_BYTES=10485760
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Required only when ANALYSIS_PROVIDER=openai_compatible
# VISION_API_KEY=
# VISION_MODEL=gpt-4.1-mini
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_TIMEOUT_SECONDS=45
